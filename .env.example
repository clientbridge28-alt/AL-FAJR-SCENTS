# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical URL where this application is hosted (e.g., https://alfajrscents.pk)
APP_URL="https://alfajrscents.pk"

# Security & Admin Authentication
# Generate a strong 32+ char random string for JWT signing in production
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
# Optional: Seed initial admin user automatically on boot (or use first-run setup UI at /admin)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Payment Gateway Credentials (Pakistan)
# Enable sandbox testing only in staging/dev
PAYMENT_SANDBOX_MODE="false"

# Safepay
SAFEPAY_PUBLIC_KEY=""
SAFEPAY_SECRET_KEY=""
SAFEPAY_WEBHOOK_SECRET=""

# PayFast
PAYFAST_MERCHANT_ID=""
PAYFAST_SECURED_KEY=""

# JazzCash
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""

# Easypaisa
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
